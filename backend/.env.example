# Copy to `.env` and adjust if needed. All settings are optional.

# Where the SQLite database lives.
# EE_DATABASE_URL="sqlite:///./data/engineering_efficiency.db"

# Directory containing the built React SPA (frontend/dist).
# EE_FRONTEND_DIST="../frontend/dist"

# Linear GraphQL endpoint (rarely needs changing).
# EE_LINEAR_API_URL="https://api.linear.app/graphql"

# Origins allowed during `vite dev` (JSON array).
# EE_CORS_ORIGINS='["http://localhost:5173"]'
