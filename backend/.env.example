# Copy to `.env` and adjust if needed. All settings are optional.

# Where the database lives. Defaults to a local SQLite file.
#
# SQLite:
# EE_DATABASE_URL="sqlite:///./data/engineering_efficiency.db"
#
# Postgres / Supabase: paste the connection string from
# Project Settings -> Database. A bare `postgresql://` URL is automatically
# pointed at the bundled psycopg driver. Prefer the Session pooler (port 5432)
# for a long-running server; the Transaction pooler (port 6543) is also
# detected and configured for PgBouncer.
# EE_DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# Directory containing the built React SPA (frontend/dist).
# EE_FRONTEND_DIST="../frontend/dist"

# Linear GraphQL endpoint (rarely needs changing).
# EE_LINEAR_API_URL="https://api.linear.app/graphql"

# Origins allowed during `vite dev` (JSON array).
# EE_CORS_ORIGINS='["http://localhost:5173"]'

# Signs the session cookie. When unset, a key is generated next to the
# SQLite file (`.session_secret`) so logins survive restarts. Set this when the
# database is remote (e.g. Supabase) so sessions survive redeploys.
# EE_SECRET_KEY=""

# Set to true when the app is served over HTTPS.
# EE_SESSION_SECURE=false
